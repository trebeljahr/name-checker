# Env & secrets — keep keys out of build context.
# No encrypted .env.production used in this repo today, so nothing is
# re-included. Added by security sweep: prevents .env / .env.keys from
# being copied via Dockerfile `COPY . .` into intermediate build
# layers, GHA caches, or local docker builds.
.env
.env.*
.env.keys
!.env.example

**/.env
**/.env.*
!**/.env.example
**/node_modules
**/.next
**/data
**/*.db
**/*.db-*
**/*.sqlite*
.git
**/*.pem
**/*.key
