{
  "name": "@starter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node --require ../../drain.cjs dist/index.js",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1048.0",
    "@starter/shared": "workspace:*",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.12",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
