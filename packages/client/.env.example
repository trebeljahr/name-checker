# Web client (packages/client): a static export. Only NEXT_PUBLIC_* values
# reach it, inlined at build time. The API runs in packages/server; in dev
# `next dev` proxies /api/* to it (API_PROXY_TARGET, set by `pnpm dev`).
API_PROXY_TARGET=http://127.0.0.1:5818

# Commit the build is made from; CI sets it. Shown in /version.json and
# <meta name="build-commit">.
# NEXT_PUBLIC_BUILD_COMMIT=

# Plausible analytics (optional; CI passes the repository variables)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
