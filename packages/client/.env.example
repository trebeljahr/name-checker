PORT=6657
# Express API server URL (for tRPC and auth)
NEXT_PUBLIC_API_URL=https://api.names.trebeljahr.com

# WebSocket server URL
NEXT_PUBLIC_WS_URL=wss://api.names.trebeljahr.com

# OpenPanel analytics (optional)
# NEXT_PUBLIC_OPENPANEL_CLIENT_ID=your-client-id

# Plausible analytics (optional)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Sentry/GlitchTip (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://key@glitchtip.example.com/2

# --- Auth (better-auth) ---
# Secret used to sign session cookies. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL the app is served at. Used in magic-link emails.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SQLite file path (relative to packages/client). Auto-created.
AUTH_DB_PATH=./data/auth.db

# --- Mail for magic-link sign-in + watch alerts ---
# Production uses a restricted project SES sender, provisioned by Hatchkit.
# Encrypt these in .env.production using the existing adjacent .env.keys.
# Do not reuse global AWS/operator credentials or enable SES before provisioning.
EMAIL_TRANSPORT=
SES_PROJECT_ACCESS_KEY_ID=
SES_PROJECT_SECRET_ACCESS_KEY=
SES_PROJECT_REGION=
SES_PROJECT_IDENTITY_ARN=
SES_PROJECT_TENANT=
SES_PROJECT_CONFIGURATION_SET=
SES_PROJECT_FROM_EMAIL=
# Non-production SES deliveries are restricted to this explicitly allowed inbox.
EMAIL_TEST_RECIPIENT=
# Optional SMTP for local development or an explicitly selected smtp transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="name-check <noreply@example.com>"

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Watch-list cron ---
# Long random string; required for /api/cron/watch to be callable.
CRON_SECRET=

# Passport mutations remain disabled until auth, billing, and providers are verified.
# Requires a canonical HTTPS BETTER_AUTH_URL (127.0.0.1 HTTP allowed in development).
PASSPORT_ACTIONS_ENABLED=0
# GitHub OAuth credentials; callback is BETTER_AUTH_URL/api/passport/callback/github.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# npm publishing requires a token supplied by the authenticated user on each request.
# PASSPORT_DEFAULT_PLAN, PASSPORT_BYPASS_PLAN and server NPM_TOKEN are not used.
