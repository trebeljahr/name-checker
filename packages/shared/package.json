{
  "name": "@starter/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "nodemailer": "^10.0.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
