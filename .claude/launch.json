{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "./node_modules/.bin/next",
      "runtimeArgs": ["dev", "--turbopack", "-p", "57492"],
      "cwd": "packages/client",
      "port": 57492,
      "autoPort": false
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "docs-site", "run", "start", "--", "--port", "4100"],
      "port": 4100,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@starter/server", "run", "dev"],
      "port": 5100,
      "autoPort": true
    }
  ]
}
